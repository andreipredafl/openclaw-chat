{
  "name": "openclaw-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Chat page for openclaw-chat. Shows the reply as it streams from the backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
