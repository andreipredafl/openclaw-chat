# Shared secret between the gateway and the backend. Generate one with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# OpenRouter API key (https://openrouter.ai/keys). Only the gateway container gets it.
# Paid models need credits on the account; free models work without.
OPENROUTER_API_KEY=

# Optional. Model for the agent, as provider/model. Default: Sonnet 5.5 through OpenRouter.
# OPENCLAW_MODEL=openrouter/anthropic/claude-sonnet-5.5
# OPENCLAW_MODEL=openrouter/minimax/minimax-m3.1-flash:free

# Optional. Host ports on 127.0.0.1, if the defaults are taken.
# FRONTEND_HOST_PORT=8080
# OPENCLAW_GATEWAY_HOST_PORT=18789

# Optional. Only when the backend runs on the host (npm run dev, npm run smoke).
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# PORT=3000
# HOST=127.0.0.1
