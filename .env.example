# Shared secret between the gateway and its clients.
# Generate one with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# OpenRouter API key (https://openrouter.ai/keys).
# Only the gateway container receives it.
# The account needs credits. OpenRouter reserves the cost of the full
# max_tokens before each request and returns HTTP 402 if the balance is short.
OPENROUTER_API_KEY=

# Optional. Model the agent uses, as provider/model. The gateway sets it at
# start (see docker-compose.yml). Default: Sonnet 5.5 through OpenRouter.
# Free OpenRouter models work with zero credits, within their rate limits.
# OPENCLAW_MODEL=openrouter/anthropic/claude-sonnet-5.5
# OPENCLAW_MODEL=openrouter/minimax/minimax-m3.1-flash:free

# Optional. Host port for the gateway on 127.0.0.1 (default 18789).
# Set it if another process already uses 18789 on your machine.
# OPENCLAW_GATEWAY_HOST_PORT=18789

# Optional. Only for running the backend outside Docker (npm run smoke).
# Must match the host port above. Inside Compose the backend uses the service name.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Optional. Where the backend listens when run outside Docker (npm run dev).
# PORT=3000
# HOST=127.0.0.1
